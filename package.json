{
  "private": true,
  "name": "coderdojo-monorepo",
  "version": "0.1.0",
  "workspaces": [
    "server",
    "ui"
  ],
  "scripts": {
    "start": "node server/index.js",
    "start-devserver": "nodemon server/index.js",
    "start-ui": "cd ui && npm run start",
    "start-both": "concurrently \"npm run start-devserver\" \"npm run start-ui\"",
    "build": "cd ui && npm install && npm run build"
  },
  "devDependencies": {
    "concurrently": "^7.0.0",
    "prettier": "^2.5.1"
  }
}
