{
  "name": "@codeclub/root",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "ui"
  ],
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "concurrently -k -n server,ui \"yarn dev:server\" \"yarn dev:ui\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "yarn workspace @codeclub/ui dev",
    "build": "yarn workspace @codeclub/ui build",
    "test": "yarn workspace @codeclub/ui test --run",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p ui/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "tsx": "4.23.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
